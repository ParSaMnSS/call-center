# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vertex AI (Gemini on enterprise infra)
# Local dev: point to a downloaded service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./your-service-account.json
# Production (Vercel): paste the full JSON file contents as one string instead
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# App base URL (used by upload action to call the processor route)
NEXT_PUBLIC_APP_URL=http://localhost:3000
